{
  "name": "syncvault",
  "version": "1.1.0",
  "description": "Local encrypted backup agent you own forever: watch folders, AES-256-GCM client-side encryption, versioning, dedupe, BYO S3-compatible storage. Pay once — no Backblaze subscription.",
  "author": "Ben (bensblueprints)",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/setup-native.js",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bensblueprints.syncvault",
    "productName": "Syncvault",
    "files": [
      "electron/**",
      "lib/**",
      "renderer/**",
      "vendor/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "menuCategory": "OneTimeSuite"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "vendor/**"
    ]
  }
}
